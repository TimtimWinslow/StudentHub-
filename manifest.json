{
  "name": "StudentHub",
  "short_name": "StudentHub",
  "description": "Your CNA class. Your progress. Your community.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "id": "./",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#071A2B",
  "theme_color": "#071A2B",
  "lang": "en-US",
