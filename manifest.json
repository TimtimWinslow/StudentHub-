{
  "name": "StudentHub",
  "short_name": "StudentHub",
  "description": "Your CNA class. Your progress. Your community.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "id": "./",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#071A2B",
  "theme_color": "#071A2B",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "education",
    "productivity"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/studenthub-mark.svg",
      "sizes": "256x256",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "assets/studenthub-favicon.svg",
      "sizes": "64x64",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "navigate-new"
    ]
  }
}
